#--*- Makefile -*--

include Makeconfig-directories

GEN_DIR      ?= ${CPP_DIR}/generated
TEMPLATE_DIR ?= ${CPP_DIR}/templates
SCRIPT_DIR   ?= ${CPP_DIR}/scripts

generate_cpp_CPP_SCRIPTS ?= $(wildcard ${SCRIPT_DIR}/*.sed)

generate_cpp_CPP_SOURCES ?= \
  ${generate_cpp_CPP_SCRIPTS:${SCRIPT_DIR}/%.sed=${GEN_DIR}/gen-torch-nn-%.cpp}

generate_cpp_CPP_OBJECTS ?= \
  ${generate_cpp_CPP_SOURCES:${GEN_DIR}/%.cpp=${OBJ_DIR}/%.o}
