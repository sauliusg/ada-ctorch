#--*- Makefile -*--

PRG_DIR ?= .
SRC_DIR ?= src
OBJ_DIR ?= .obj
ADA_DIR ?= .

ADA_GEN_DIR ?= ${ADA_DIR}/generated

ADA_GEN_FILES ?= \
    ${ADA_GEN_DIR}/torch_element_codes_h.ads \
    ${ADA_GEN_DIR}/ada_dataloader_codes_h.ads

all: ${ADA_GEN_FILES}

${ADA_GEN_DIR}/%_h.ads: ${SRC_DIR}/cpp/%.h
	cd $(dir $@); \
	gcc -c -fdump-ada-spec ../$<

.PHONY: generate-ada-clean

generate-ada-clean:
	rm -f ${ADA_GEN_FILES}

clean: generate-ada-clean
