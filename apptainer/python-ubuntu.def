BootStrap: localimage
From: ubuntu_24.04.sif

%post
   apt-get -y update
   apt-get -y install valgrind duma electric-fence
   apt-get -y install g++ libstdc++-11-dev  libstdc++-12-dev
   apt-get -y install git
   apt-get -y install python3 python-is-python3 python3-pip python3-venv virtualenv

%environment
   export LC_ALL=C
